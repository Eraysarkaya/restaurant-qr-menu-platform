# PostgreSQL (yerelde veya Neon/Supabase/Railway üzerinde)
APP_ENV="development"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kose_mutfak"
# İsteğe bağlı node-postgres pool üst sınırı (Vercel/sağlayıcı limitinize göre ayarlayın).
DATABASE_POOL_MAX="10"

# En az 32 karakterlik rastgele değerler kullanın.
BETTER_AUTH_SECRET="change-me-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
# Üretimde tüm Vercel örneklerinde aynı 32 baytlık base64 anahtarı kullanın:
# openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# İlk admin yalnızca seed/bootstrap sırasında oluşturulur.
ADMIN_BOOTSTRAP_NAME="İşletme Sahibi"
ADMIN_BOOTSTRAP_EMAIL="admin@kosemutfak.local"
ADMIN_BOOTSTRAP_PASSWORD="change-this-development-password"

# Restoran admininden ayrı geliştirici kontrol paneli (/platform).
# Bu bilgiler de yalnız seed sırasında kullanılır ve production ortamında güçlü olmalıdır.
PLATFORM_BOOTSTRAP_NAME="Platform Geliştiricisi"
PLATFORM_BOOTSTRAP_EMAIL="developer@platform.local"
PLATFORM_BOOTSTRAP_PASSWORD="change-this-platform-password"

# Cloudinary sunucu tarafı görsel yüklemeleri
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
